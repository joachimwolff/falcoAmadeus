#!/usr/bin/env bash

tar -zxf test_build/test_data.tgz -C test_build
infiles=$(ls --color=no test_build/*.fastq)

fail=0
for i in ${infiles}
do
  a=$(basename $i ".fastq")
  mkdir -p test_output/${a}
  ./falcoAmadeus -o test_output/${a} ${i} \
       1>test_output/${a}/${a}.output  \
       2>test_output/${a}/${a}.error
  sample_fail=0
  for j in test_output/${a}/*.txt; do
      x=$(md5sum -c test_build/md5sum.txt --ignore-missing | grep "${j}:" | cut -d ' ' -f 2);
      if [[ "${x}" != "OK" ]]; then
          echo "${a} failed on ${j}"
          sample_fail=1
          fail=1
      fi
  done
  # keep only the output of samples that failed
  if [ ${sample_fail} == 0 ]; then
      rm -r test_output/${a}
  fi
done

rmdir test_output 2>/dev/null || true
rm ${infiles}

exit ${fail}
